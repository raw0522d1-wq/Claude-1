// ═══════════════ MODULE S0 · TRADE ACCOUNTING & RISK STATE (strategy) ══════
pointVal = ptValOverride > 0 ? ptValOverride : syminfo.pointvalue

var bool  pendingActive = false
var string pendId = ""
var float curStop = na
var float initQty = 0.0
var float tradeRiskDollars = na
var float tradeCumPnl = 0.0
var float lastScoreAtEntry = 0.0
var string typeAtEntry = ""
var string sessAtEntry = ""
var int   dowAtEntry = 0
var bool  beDone = false
var int   entryBarActual = 0

var int   tradesToday = 0
var int   tradesSess = 0
var float dayR = 0.0
var float weekR = 0.0
var int   consecLoss = 0
var int   maxConsecLossEver = 0
var bool  riskLocked = false
var string lockReason = ""

var array<int>   bW = array.new<int>(6, 0)      // score buckets 70-74 … 95-100
var array<int>   bL = array.new<int>(6, 0)
var array<float> bRsum = array.new<float>(6, 0.0)
var array<float> dR = array.new<float>(6, 0.0)  // weekday R (Mon..Fri)
var array<int>   dN = array.new<int>(6, 0)
var array<float> sR = array.new<float>(5, 0.0)  // per-setup R (TS,JUD,FVGC,BRK,SMTR)
var array<int>   sN = array.new<int>(5, 0)
var array<float> tradeRs = array.new<float>()
var array<float> tradePnls = array.new<float>()

f_setupIdx(string t) => t == "TURTLE_SOUP" ? 0 : t == "JUDAS_SWING" ? 1 : t == "FVG_CONTINUATION" ? 2 : t == "BREAKER_RETEST" ? 3 : 4
f_bucketIdx(float sc) => sc >= 95 ? 5 : sc >= 90 ? 4 : sc >= 85 ? 3 : sc >= 80 ? 2 : sc >= 75 ? 1 : 0
f_dowIdx(int d) => d == dayofweek.monday ? 0 : d == dayofweek.tuesday ? 1 : d == dayofweek.wednesday ? 2 : d == dayofweek.thursday ? 3 : 4

f_wilson(int w, int n, bool upper) =>
    float r = na
    if n > 0
        float z = 1.96
        float p = 1.0 * w / n
        float dd = 1.0 + z * z / n
        float c = p + z * z / (2.0 * n)
        float m = z * math.sqrt(p * (1.0 - p) / n + z * z / (4.0 * n * n))
        r := upper ? (c + m) / dd : (c - m) / dd
    r

if barstate.isconfirmed
    if newDay
        tradesToday := 0
        dayR := 0.0
        consecLoss := 0
        riskLocked := false
        lockReason := ""
    if newWeek
        weekR := 0.0
    if sessTag != lastSessTag[1]
        tradesSess := 0
    // account fills recorded during this bar
    int newClosed = strategy.closedtrades - nz(strategy.closedtrades[1])
    if newClosed > 0
        for k = strategy.closedtrades - newClosed to strategy.closedtrades - 1
            float pr = strategy.closedtrades.profit(k)
            tradeCumPnl += pr
            if not na(tradeRiskDollars) and tradeRiskDollars > 0
                dayR += pr / tradeRiskDollars
                weekR += pr / tradeRiskDollars
    bool flatNow = strategy.position_size == 0
    bool wasOpen = strategy.position_size[1] != 0
    if flatNow and wasOpen
        tradesToday += 1
        tradesSess += 1
        float tradeR = not na(tradeRiskDollars) and tradeRiskDollars > 0 ? tradeCumPnl / tradeRiskDollars : 0.0
        bool win = tradeCumPnl > 0
        consecLoss := win ? 0 : consecLoss + 1
        maxConsecLossEver := math.max(maxConsecLossEver, consecLoss)
        int bi = f_bucketIdx(lastScoreAtEntry)
        if win
            array.set(bW, bi, array.get(bW, bi) + 1)
        else
            array.set(bL, bi, array.get(bL, bi) + 1)
        array.set(bRsum, bi, array.get(bRsum, bi) + tradeR)
        int wi = f_dowIdx(dowAtEntry)
        array.set(dR, wi, array.get(dR, wi) + tradeR)
        array.set(dN, wi, array.get(dN, wi) + 1)
        int si = f_setupIdx(typeAtEntry)
        array.set(sR, si, array.get(sR, si) + tradeR)
        array.set(sN, si, array.get(sN, si) + 1)
        array.push(tradeRs, tradeR)
        array.push(tradePnls, tradeCumPnl)
        if array.size(tradeRs) > 2000
            array.remove(tradeRs, 0)
            array.remove(tradePnls, 0)
        tradeCumPnl := 0.0
        beDone := false
        cooldownUntil := math.max(cooldownUntil, bar_index + cooldownBars)
    // lockout evaluation
    bool wasLocked = riskLocked
    if dayR <= -dailyStopR
        riskLocked := true
        lockReason := "DAILY_LOSS"
    if consecLoss >= maxConsecLoss
        riskLocked := true
        lockReason := "CONSEC_LOSS"
    if tradesToday >= maxTradesDay
        riskLocked := true
        lockReason := "MAX_TRADES_DAY"
    if weeklyStopR > 0 and weekR <= -weeklyStopR
        riskLocked := true
        lockReason := "WEEKLY_LOSS"
    if profitLockR > 0 and dayR >= profitLockR
        riskLocked := true
        lockReason := "PROFIT_TARGET"
    if killSwitch
        riskLocked := true
        lockReason := "KILL_SWITCH"
    if riskLocked and not wasLocked
        evLockout := true

inDateRange = not useDateFilt or (time >= dateStart and time <= dateEnd)
synthChart  = chart.is_heikinashi or chart.is_renko or chart.is_range
execOk      = not blockSynth or not synthChart
stratGate   = strategy.position_size == 0 and not pendingActive and not riskLocked and inDateRange and execOk and tradesSess < maxTradesSess

// ═══════════════════════════════ MODULE 16 · CONFIRMED-BAR ENGINE ══════════
minPenV = math.max(swMinTicks * tick, swMinAtr * atr)
maxPenV = swMaxAtr * atr
mssBuf  = mssBufTicks * tick
warm    = bar_index > warmupBars and htfCfgOk

bool bullReclaim = false
bool bearReclaim = false
float bRLvl = na
string bRKind = ""
int bRPrio = 99
float bRExt = na
int bRStart = 0
int bRTime = 0
bool bPend = false
float sRLvl = na
string sRKind = ""
int sRPrio = 99
float sRExt = na
int sRStart = 0
int sRTime = 0
bool sPend = false

if barstate.isconfirmed
    // ── 16.1 refresh HTF liquidity levels ──
    if newDay and not na(pdH)
        f_removeKind("PDH")
        f_removeKind("PDL")
        f_addLevel("PDH", pdH, true, 3)
        f_addLevel("PDL", pdL, false, 3)
    if newWeek and not na(pwH)
        f_removeKind("PWH")
        f_removeKind("PWL")
        f_addLevel("PWH", pwH, true, 2)
        f_addLevel("PWL", pwL, false, 2)
    if newMonth and not na(pmH)
        f_removeKind("PMH")
        f_removeKind("PML")
        f_addLevel("PMH", pmH, true, 1)
        f_addLevel("PML", pmL, false, 1)

    // ── 16.2 session ranges → eligible liquidity only AFTER the session ends ──
    var float aHi = na
    var float aLo = na
    if inAsia and not inAsia[1]
        aHi := high
        aLo := low
    else if inAsia
        aHi := math.max(nz(aHi, high), high)
        aLo := math.min(nz(aLo, low), low)
    if not inAsia and inAsia[1] and not na(aHi)
        f_removeKind("ASIA_H")
        f_removeKind("ASIA_L")
        f_addLevel("ASIA_H", aHi, true, 5)
        f_addLevel("ASIA_L", aLo, false, 5)
    var float lHi = na
    var float lLo = na
    if inLKZ and not inLKZ[1]
        lHi := high
        lLo := low
    else if inLKZ
        lHi := math.max(nz(lHi, high), high)
        lLo := math.min(nz(lLo, low), low)
    if not inLKZ and inLKZ[1] and not na(lHi)
        f_removeKind("LON_H")
        f_removeKind("LON_L")
        f_addLevel("LON_H", lHi, true, 6)
        f_addLevel("LON_L", lLo, false, 6)
    var float pHi = na
    var float pLo = na
    if inPre and not inPre[1]
        pHi := high
        pLo := low
    else if inPre
        pHi := math.max(nz(pHi, high), high)
        pLo := math.min(nz(pLo, low), low)
    if not inPre and inPre[1] and not na(pHi)
        f_removeKind("PRE_H")
        f_removeKind("PRE_L")
        f_addLevel("PRE_H", pHi, true, 7)
        f_addLevel("PRE_L", pLo, false, 7)
    var float oHi = na
    var float oLo = na
    if inOR and not inOR[1]
        oHi := high
        oLo := low
    else if inOR
        oHi := math.max(nz(oHi, high), high)
        oLo := math.min(nz(oLo, low), low)
    if not inOR and inOR[1] and not na(oHi)
        f_removeKind("OR_H")
        f_removeKind("OR_L")
        f_addLevel("OR_H", oHi, true, 8)
        f_addLevel("OR_L", oLo, false, 8)

    // ── 16.3 confirmed swings → dealing range, equal H/L, swing liquidity ──
    if not na(phI)
        f_pushSwing(intHi, phI, bar_index - intR)
        float eqTol = math.max(eqMinTicks * tick, eqAtrTol * atr)
        int nH = array.size(intHi)
        if nH >= 2
            for i = 0 to nH - 2
                Swing s = array.get(intHi, i)
                int gap = (bar_index - intR) - s.pivotBar
                if gap >= eqMinBars and gap <= eqMaxBars and math.abs(s.price - phI) <= eqTol
                    float dip = na
                    int nL = array.size(intLo)
                    if nL > 0
                        for j = 0 to nL - 1
                            Swing sl = array.get(intLo, j)
                            if sl.pivotBar > s.pivotBar and sl.pivotBar < bar_index - intR
                                dip := na(dip) ? sl.price : math.min(dip, sl.price)
                    if not na(dip) and math.max(s.price, phI) - dip >= eqPromAtr * atr
                        f_addLevel("EQH", math.max(s.price, phI), true, 9)
                        f_capKind("EQH", 3)
    if not na(plI)
        f_pushSwing(intLo, plI, bar_index - intR)
        float eqTol2 = math.max(eqMinTicks * tick, eqAtrTol * atr)
        int nL2 = array.size(intLo)
        if nL2 >= 2
            for i = 0 to nL2 - 2
                Swing s = array.get(intLo, i)
                int gap = (bar_index - intR) - s.pivotBar
                if gap >= eqMinBars and gap <= eqMaxBars and math.abs(s.price - plI) <= eqTol2
                    float pk = na
                    int nH2 = array.size(intHi)
                    if nH2 > 0
                        for j = 0 to nH2 - 1
                            Swing sh = array.get(intHi, j)
                            if sh.pivotBar > s.pivotBar and sh.pivotBar < bar_index - intR
                                pk := na(pk) ? sh.price : math.max(pk, sh.price)
                    if not na(pk) and pk - math.min(s.price, plI) >= eqPromAtr * atr
                        f_addLevel("EQL", math.min(s.price, plI), false, 9)
                        f_capKind("EQL", 3)
    if not na(phE)
        f_pushSwing(extHi, phE, bar_index - extR)
        drHigh := phE
        pH2 := pH1
        pH1 := phE
        pH1b := bar_index
        f_addLevel("SWH", phE, true, 10)
        f_capKind("SWH", 4)
    if not na(plE)
        f_pushSwing(extLo, plE, bar_index - extR)
        drLow := plE
        pL2 := pL1
        pL1 := plE
        pL1b := bar_index
        f_addLevel("SWL", plE, false, 10)
        f_capKind("SWL", 4)
    if not na(phI)
        f_addLevel("IWH", phI, true, 11)
        f_capKind("IWH", 3)
    if not na(plI)
        f_addLevel("IWL", plI, false, 11)
        f_capKind("IWL", 3)

    // ── 16.4 FVG list maintenance ──
    if fvgBullNew
        bool q = (low - high[2]) >= fvgMinSz and (dispBull or dispBull[1])
        box bfx = na
        if showFvg
            bfx := box.new(bar_index - 2, low, bar_index + 1, high[2], border_color = color.new(color.green, 60), bgcolor = color.new(color.green, q ? 82 : 92), extend = extend.right)
        array.push(fvgs, Fvg.new(low, high[2], 1, bar_index, 0, 0.0, true, q, bfx))
    if fvgBearNew
        bool q = (low[2] - high) >= fvgMinSz and (dispBear or dispBear[1])
        box bfx = na
        if showFvg
            bfx := box.new(bar_index - 2, low[2], bar_index + 1, high, border_color = color.new(color.red, 60), bgcolor = color.new(color.red, q ? 82 : 92), extend = extend.right)
        array.push(fvgs, Fvg.new(low[2], high, -1, bar_index, 0, 0.0, true, q, bfx))
    int nf = array.size(fvgs)
    if nf > 0
        for i = nf - 1 to 0
            Fvg f = array.get(fvgs, i)
            if f.active and f.createdBar < bar_index
                if f.dir == 1
                    if low <= f.top
                        f.touches += 1
                        f.fillPct := math.max(f.fillPct, (f.top - math.max(low, f.bottom)) / math.max(f.top - f.bottom, tick))
                    if low <= f.bottom
                        f.active := false
                else
                    if high >= f.bottom
                        f.touches += 1
                        f.fillPct := math.max(f.fillPct, (math.min(high, f.top) - f.bottom) / math.max(f.top - f.bottom, tick))
                    if high >= f.top
                        f.active := false
            if f.active and bar_index - f.createdBar > fvgMaxAge
                f.active := false
            if not f.active and not na(f.bx)
                box.set_extend(f.bx, extend.none)
                box.set_right(f.bx, bar_index)
            if bar_index - f.createdBar > fvgMaxAge * 2
                if not na(f.bx)
                    box.delete(f.bx)
                array.remove(fvgs, i)

    // ── 16.5 sweep engines ──
    if warm
        [r1, l1, k1, q1_, e1, s1, tt1, pd1] = f_sweep(true, minPenV, maxPenV)
        bullReclaim := r1
        bRLvl := l1
        bRKind := k1
        bRPrio := q1_
        bRExt := e1
        bRStart := s1
        bRTime := tt1
        bPend := pd1
        [r2, l2, k2, q2_, e2, s2, tt2, pd2] = f_sweep(false, minPenV, maxPenV)
        bearReclaim := r2
        sRLvl := l2
        sRKind := k2
        sRPrio := q2_
        sRExt := e2
        sRStart := s2
        sRTime := tt2
        sPend := pd2

    // ── 16.6 daily / session counters ──
    if newDay
        sigDay := 0
        longsDay := 0
        shortsDay := 0
        judasCountDay := 0
    if sessTag != lastSessTag
        sigSess := 0
        lastSessTag := sessTag

    bool baseGate = warm and sessionEligible and bar_index >= cooldownUntil and sigDay < maxSigDay and sigSess < maxSigSess and not suOn and stratGate

    // ── 16.7 reversal context creation (DEVELOPING state) ──
    bool isJudasWin = (useLKZ and inLKZ) or inPref
    int barsFromOpen = math.min(nz(barsSinceNYAM, 9999), nz(barsSinceLKZ, 9999))
    float judOpen = inLKZ ? lkzOpen : o0930
    if bullReclaim and not rcbOn and baseGate
        float mssPx = f_lastSwingBefore(intHi, bRStart)
        if not na(mssPx)
            rcbOn := true
            rcbMss := mssPx
            rcbDead := bar_index + mssDeadline
            rcbExt := bRExt
            rcbKind := bRKind
            rcbLvl := bRLvl
            rcbPrio := bRPrio
            rcbSweepBar := bRStart
            rcbSweepTime := bRTime
            rcbJudas := isJudasWin and barsFromOpen <= judMaxBars and (bRKind == "OR_L" or bRKind == "PRE_L" or bRKind == "ASIA_L" or bRKind == "PDL" or bRKind == "LON_L") and not na(judOpen) and judOpen - bRExt >= judMinAtr * atr
            evDevBull := true
    if bearReclaim and not rcsOn and baseGate
        float mssPx = f_lastSwingBefore(intLo, sRStart)
        if not na(mssPx)
            rcsOn := true
            rcsMss := mssPx
            rcsDead := bar_index + mssDeadline
            rcsExt := sRExt
            rcsKind := sRKind
            rcsLvl := sRLvl
            rcsPrio := sRPrio
            rcsSweepBar := sRStart
            rcsSweepTime := sRTime
            rcsJudas := isJudasWin and barsFromOpen <= judMaxBars and (sRKind == "OR_H" or sRKind == "PRE_H" or sRKind == "ASIA_H" or sRKind == "PDH" or sRKind == "LON_H") and not na(judOpen) and sRExt - judOpen >= judMinAtr * atr
            evDevBear := true

    // ── 16.8 SMT divergence state (informational + confirmation) ──
    bool sBull1 = smt1Avail and f_smtBull(x1H1, x1H2, x1H1b, x1L1, x1L2, x1L1b)
    bool sBear1 = smt1Avail and f_smtBear(x1H1, x1H2, x1H1b, x1L1, x1L2, x1L1b)
    bool sBull2 = smt2Avail and f_smtBull(x2H1, x2H2, x2H1b, x2L1, x2L2, x2L1b)
    bool sBear2 = smt2Avail and f_smtBear(x2H1, x2H2, x2H1b, x2L1, x2L2, x2L1b)
    bool smtBullRaw = smtBoth and smtUse2 ? sBull1 and sBull2 : sBull1 or sBull2
    bool smtBearRaw = smtBoth and smtUse2 ? sBear1 and sBear2 : sBear1 or sBear2
    string bullKey = str.tostring(pL1b) + "_" + str.tostring(x1L1b)
    string bearKey = str.tostring(pH1b) + "_" + str.tostring(x1H1b)
    if smtBullRaw and bullKey != lastSmtBullKey
        smtBullBar := bar_index
        lastSmtBullKey := bullKey
        evSmtInfo := true
    if smtBearRaw and bearKey != lastSmtBearKey
        smtBearBar := bar_index
        lastSmtBearKey := bearKey
        evSmtInfo := true
    bool smtBullOk = bar_index - smtBullBar <= smtValidBars
    bool smtBearOk = bar_index - smtBearBar <= smtValidBars

    // ── 16.9 MSS confirmation → reversal setup (Turtle Soup / Judas / SMT) ──
    if rcbOn
        if bar_index > rcbDead or close < rcbExt
            rcbOn := false
            evInvalid := evInvalid or devShow
        else if close > rcbMss + mssBuf and dispBull
            mssBullNow := true
            Zone obz = f_captureOb(1)
            Fvg ef = f_pickFvg(1, rcbSweepBar)
            float zTop = na
            float zBot = na
            string arrKind = ""
            int arrTouch = 0
            if not na(ef)
                zTop := ef.top
                zBot := ef.bottom
                arrKind := "FVG"
                arrTouch := ef.touches
            else if not requireFvg and not na(obz)
                zTop := obz.top
                zBot := obz.bottom
                arrKind := "OB"
            if arrKind != ""
                float entryPx = entryMode == "Market on close" ? close : entryMode == "FVG proximal" ? zTop : entryMode == "FVG percent" ? zTop - (zTop - zBot) * entryPct / 100 : (zTop + zBot) / 2
                float stpPx = stopMode == "Sweep extreme + ticks" ? rcbExt - stopBufTicks * tick : stopMode == "Sweep extreme + ATR" ? rcbExt - stopBufAtr * atr : zBot - stopBufTicks * tick
                float risk = entryPx - stpPx
                if risk >= minStopTicks * tick and risk <= maxStopAtr * atr
                    [fin, finKind, oppD] = f_draw(1, entryPx, risk)
                    float rr = (fin - entryPx) / risk
                    bool oppNear = not na(oppD) and oppD < risk
                    bool inOte = not na(oteLongLo) and entryPx >= oteLongLo and entryPx <= oteLongHi
                    string typ = enSmtR and smtBullOk and rcbPrio <= 6 ? "SMT_REVERSAL" : enJud and rcbJudas and judasCountDay < 1 ? "JUDAS_SWING" : enTS ? "TURTLE_SOUP" : ""
                    bool biasGate = biasMode == "A · Strict alignment" ? biasDir >= 0 : biasMode == "B · Adaptive liquidity reversal" ? (biasDir >= 0 or (rcbPrio <= 6 and inDiscount)) : true
                    bool smtGate = typ == "SMT_REVERSAL" ? smtBullOk : biasMode == "C · Neutral research" and smtMandC ? smtBullOk : true
                    bool dirCap = not oneEachSide or longsDay < 1
                    if typ != "" and biasGate and smtGate and dirCap and rr >= minRR and not (rejectOppClose and oppNear) and not chaseBar
                        [sc, det] = f_score(1, rcbPrio, rr, arrKind, arrTouch, smtBullOk, inOte, false, oppNear)
                        float scoreReq = biasMode == "C · Neutral research" ? minScore + 5 : minScore
                        if sc >= scoreReq
                            suOn := true
                            suId := syminfo.tickerid + "|" + typ + "|L|" + rcbKind + "|" + f_px(rcbLvl) + "|" + str.tostring(rcbSweepTime) + "|" + str.tostring(time)
                            suType := typ
                            suDir := 1
                            suState := ST_ENTRY_ACTIVE
                            suEntry := f_rt(entryPx)
                            suStop := f_rt(stpPx)
                            suT1 := f_rt(entryPx + risk * tp1R)
                            suT2 := f_rt(entryPx + risk * tp2R)
                            suFin := f_rt(fin)
                            suRR := rr
                            suScore := sc
                            suDet := det
                            suLiqKind := rcbKind
                            suConfirmBar := bar_index
                            suExpiryBar := bar_index + entryExpiry
                            suSweepExt := rcbExt
                            suSmt := smtBullOk
                            sigDay += 1
                            sigSess += 1
                            longsDay += 1
                            if typ == "JUDAS_SWING"
                                judasCountDay += 1
                            evQualBull := true
                            evTsBull := typ == "TURTLE_SOUP"
                            evJudBull := typ == "JUDAS_SWING"
                            evSmtRBull := typ == "SMT_REVERSAL"
            rcbOn := false
    if rcsOn
        if bar_index > rcsDead or close > rcsExt
            rcsOn := false
            evInvalid := evInvalid or devShow
        else if close < rcsMss - mssBuf and dispBear
            mssBearNow := true
            Zone obz = f_captureOb(-1)
            Fvg ef = f_pickFvg(-1, rcsSweepBar)
            float zTop = na
            float zBot = na
            string arrKind = ""
            int arrTouch = 0
            if not na(ef)
                zTop := ef.top
                zBot := ef.bottom
                arrKind := "FVG"
                arrTouch := ef.touches
            else if not requireFvg and not na(obz)
                zTop := obz.top
                zBot := obz.bottom
                arrKind := "OB"
            if arrKind != ""
                float entryPx = entryMode == "Market on close" ? close : entryMode == "FVG proximal" ? zBot : entryMode == "FVG percent" ? zBot + (zTop - zBot) * entryPct / 100 : (zTop + zBot) / 2
                float stpPx = stopMode == "Sweep extreme + ticks" ? rcsExt + stopBufTicks * tick : stopMode == "Sweep extreme + ATR" ? rcsExt + stopBufAtr * atr : zTop + stopBufTicks * tick
                float risk = stpPx - entryPx
                if risk >= minStopTicks * tick and risk <= maxStopAtr * atr
                    [fin, finKind, oppD] = f_draw(-1, entryPx, risk)
                    float rr = (entryPx - fin) / risk
                    bool oppNear = not na(oppD) and oppD < risk
                    bool inOte = not na(oteShortLo) and entryPx >= oteShortLo and entryPx <= oteShortHi
                    string typ = enSmtR and smtBearOk and rcsPrio <= 6 ? "SMT_REVERSAL" : enJud and rcsJudas and judasCountDay < 1 ? "JUDAS_SWING" : enTS ? "TURTLE_SOUP" : ""
                    bool biasGate = biasMode == "A · Strict alignment" ? biasDir <= 0 : biasMode == "B · Adaptive liquidity reversal" ? (biasDir <= 0 or (rcsPrio <= 6 and inPremium)) : true
                    bool smtGate = typ == "SMT_REVERSAL" ? smtBearOk : biasMode == "C · Neutral research" and smtMandC ? smtBearOk : true
                    bool dirCap = not oneEachSide or shortsDay < 1
                    if typ != "" and biasGate and smtGate and dirCap and rr >= minRR and not (rejectOppClose and oppNear) and not chaseBar
                        [sc, det] = f_score(-1, rcsPrio, rr, arrKind, arrTouch, smtBearOk, inOte, false, oppNear)
                        float scoreReq = biasMode == "C · Neutral research" ? minScore + 5 : minScore
                        if sc >= scoreReq
                            suOn := true
                            suId := syminfo.tickerid + "|" + typ + "|S|" + rcsKind + "|" + f_px(rcsLvl) + "|" + str.tostring(rcsSweepTime) + "|" + str.tostring(time)
                            suType := typ
                            suDir := -1
                            suState := ST_ENTRY_ACTIVE
                            suEntry := f_rt(entryPx)
                            suStop := f_rt(stpPx)
                            suT1 := f_rt(entryPx - risk * tp1R)
                            suT2 := f_rt(entryPx - risk * tp2R)
                            suFin := f_rt(fin)
                            suRR := rr
                            suScore := sc
                            suDet := det
                            suLiqKind := rcsKind
                            suConfirmBar := bar_index
                            suExpiryBar := bar_index + entryExpiry
                            suSweepExt := rcsExt
                            suSmt := smtBearOk
                            sigDay += 1
                            sigSess += 1
                            shortsDay += 1
                            if typ == "JUDAS_SWING"
                                judasCountDay += 1
                            evQualBear := true
                            evTsBear := typ == "TURTLE_SOUP"
                            evJudBear := typ == "JUDAS_SWING"
                            evSmtRBear := typ == "SMT_REVERSAL"
            rcsOn := false

    // ── 16.10 Setup 3 · FVG continuation (bias-aligned displacement BOS) ──
    if enFvgC and baseGate and not suOn and biasDir != 0
        if biasDir == 1 and dispBull and bar_index - contBosBarB > contCooldown
            float sh = f_lastSwingBefore(intHi, bar_index - 1)
            if not na(sh) and close > sh + mssBuf and fvgBullNew and (low - high[2]) >= fvgMinSz
                contBosBarB := bar_index
                mssBullNow := true
                f_captureOb(1)
                float zTop = low
                float zBot = high[2]
                float entryPx = entryMode == "Market on close" ? close : entryMode == "FVG proximal" ? zTop : entryMode == "FVG percent" ? zTop - (zTop - zBot) * entryPct / 100 : (zTop + zBot) / 2
                float stpPx = math.min(zBot, net3Lo) - stopBufTicks * tick
                float risk = entryPx - stpPx
                if risk >= minStopTicks * tick and risk <= maxStopAtr * atr
                    [fin, finKind, oppD] = f_draw(1, entryPx, risk)
                    float rr = (fin - entryPx) / risk
                    bool oppNear = not na(oppD) and oppD < risk
                    bool late = (fin - close) < (fin - entryPx) * 0.6
                    bool inOte = not na(oteLongLo) and entryPx >= oteLongLo and entryPx <= oteLongHi
                    bool dirCap = not oneEachSide or longsDay < 1
                    if dirCap and rr >= minRR and not (rejectOppClose and oppNear) and not chaseBar
                        [sc, det] = f_score(1, 10, rr, "FVG", 0, bar_index - smtBullBar <= smtValidBars, inOte, late, oppNear)
                        if sc >= minScore
                            suOn := true
                            suId := syminfo.tickerid + "|FVG_CONTINUATION|L|BOS|" + f_px(sh) + "|" + str.tostring(time) + "|" + str.tostring(time)
                            suType := "FVG_CONTINUATION"
                            suDir := 1
                            suState := ST_ENTRY_ACTIVE
                            suEntry := f_rt(entryPx)
                            suStop := f_rt(stpPx)
                            suT1 := f_rt(entryPx + risk * tp1R)
                            suT2 := f_rt(entryPx + risk * tp2R)
                            suFin := f_rt(fin)
                            suRR := rr
                            suScore := sc
                            suDet := det
                            suLiqKind := "BOS_FVG"
                            suConfirmBar := bar_index
                            suExpiryBar := bar_index + entryExpiry
                            suSweepExt := stpPx
                            suSmt := bar_index - smtBullBar <= smtValidBars
                            sigDay += 1
                            sigSess += 1
                            longsDay += 1
                            evQualBull := true
                            evFvgBull := true
        if biasDir == -1 and dispBear and bar_index - contBosBarS > contCooldown
            float slw = f_lastSwingBefore(intLo, bar_index - 1)
            if not na(slw) and close < slw - mssBuf and fvgBearNew and (low[2] - high) >= fvgMinSz
                contBosBarS := bar_index
                mssBearNow := true
                f_captureOb(-1)
                float zTop = low[2]
                float zBot = high
                float entryPx = entryMode == "Market on close" ? close : entryMode == "FVG proximal" ? zBot : entryMode == "FVG percent" ? zBot + (zTop - zBot) * entryPct / 100 : (zTop + zBot) / 2
                float stpPx = math.max(zTop, net3Hi) + stopBufTicks * tick
                float risk = stpPx - entryPx
                if risk >= minStopTicks * tick and risk <= maxStopAtr * atr
                    [fin, finKind, oppD] = f_draw(-1, entryPx, risk)
                    float rr = (entryPx - fin) / risk
                    bool oppNear = not na(oppD) and oppD < risk
                    bool late = (close - fin) < (entryPx - fin) * 0.6
                    bool inOte = not na(oteShortLo) and entryPx >= oteShortLo and entryPx <= oteShortHi
                    bool dirCap = not oneEachSide or shortsDay < 1
                    if dirCap and rr >= minRR and not (rejectOppClose and oppNear) and not chaseBar
                        [sc, det] = f_score(-1, 10, rr, "FVG", 0, bar_index - smtBearBar <= smtValidBars, inOte, late, oppNear)
                        if sc >= minScore
                            suOn := true
                            suId := syminfo.tickerid + "|FVG_CONTINUATION|S|BOS|" + f_px(slw) + "|" + str.tostring(time) + "|" + str.tostring(time)
                            suType := "FVG_CONTINUATION"
                            suDir := -1
                            suState := ST_ENTRY_ACTIVE
                            suEntry := f_rt(entryPx)
                            suStop := f_rt(stpPx)
                            suT1 := f_rt(entryPx - risk * tp1R)
                            suT2 := f_rt(entryPx - risk * tp2R)
                            suFin := f_rt(fin)
                            suRR := rr
                            suScore := sc
                            suDet := det
                            suLiqKind := "BOS_FVG"
                            suConfirmBar := bar_index
                            suExpiryBar := bar_index + entryExpiry
                            suSweepExt := stpPx
                            suSmt := bar_index - smtBearBar <= smtValidBars
                            sigDay += 1
                            sigSess += 1
                            shortsDay += 1
                            evQualBear := true
                            evFvgBear := true

    // ── 16.11 Setup 4 · Breaker block retest ──
    int nzz = array.size(zones)
    if nzz > 0
        for i = nzz - 1 to 0
            Zone z = array.get(zones, i)
            if z.active and not z.isBreaker and z.createdBar < bar_index
                if z.dir == 1 and close < z.bottom and dispBear and mssBearNow
                    z.broken := true
                    z.brokenBar := bar_index
                    z.isBreaker := true
                    z.touches := 0
                    if showZones and na(z.bx)
                        z.bx := box.new(z.createdBar, z.top, bar_index + 1, z.bottom, border_color = color.new(color.orange, 40), bgcolor = color.new(color.orange, 85), extend = extend.right)
                if z.dir == -1 and close > z.top and dispBull and mssBullNow
                    z.broken := true
                    z.brokenBar := bar_index
                    z.isBreaker := true
                    z.touches := 0
                    if showZones and na(z.bx)
                        z.bx := box.new(z.createdBar, z.top, bar_index + 1, z.bottom, border_color = color.new(color.orange, 40), bgcolor = color.new(color.orange, 85), extend = extend.right)
            else if z.active and z.isBreaker and bar_index > z.brokenBar
                if bar_index - z.brokenBar > brkMaxAge
                    z.active := false
                else if z.dir == -1
                    if low <= z.top and close > z.top
                        if enBrk and baseGate and not suOn and z.touches <= brkMaxMitig
                            float entryPx = entryMode == "Market on close" ? close : (z.top + z.bottom) / 2
                            float stpPx = z.bottom - stopBufTicks * tick
                            float risk = entryPx - stpPx
                            if risk >= minStopTicks * tick and risk <= maxStopAtr * atr
                                [fin, finKind, oppD] = f_draw(1, entryPx, risk)
                                float rr = (fin - entryPx) / risk
                                bool oppNear = not na(oppD) and oppD < risk
                                bool biasGate = biasMode == "A · Strict alignment" ? biasDir >= 0 : true
                                bool inOte = not na(oteLongLo) and entryPx >= oteLongLo and entryPx <= oteLongHi
                                bool dirCap = not oneEachSide or longsDay < 1
                                if biasGate and dirCap and rr >= minRR and not (rejectOppClose and oppNear) and not chaseBar
                                    [sc, det] = f_score(1, 10, rr, "BRK", z.touches, bar_index - smtBullBar <= smtValidBars, inOte, false, oppNear)
                                    if sc >= minScore
                                        suOn := true
                                        suId := syminfo.tickerid + "|BREAKER_RETEST|L|BRK|" + f_px(z.top) + "|" + str.tostring(z.brokenBar) + "|" + str.tostring(time)
                                        suType := "BREAKER_RETEST"
                                        suDir := 1
                                        suState := ST_ENTRY_ACTIVE
                                        suEntry := f_rt(entryPx)
                                        suStop := f_rt(stpPx)
                                        suT1 := f_rt(entryPx + risk * tp1R)
                                        suT2 := f_rt(entryPx + risk * tp2R)
                                        suFin := f_rt(fin)
                                        suRR := rr
                                        suScore := sc
                                        suDet := det
                                        suLiqKind := "BREAKER"
                                        suConfirmBar := bar_index
                                        suExpiryBar := bar_index + entryExpiry
                                        suSweepExt := stpPx
                                        suSmt := bar_index - smtBullBar <= smtValidBars
                                        sigDay += 1
                                        sigSess += 1
                                        longsDay += 1
                                        evQualBull := true
                                        evBrkBull := true
                        z.touches += 1
                    else if close < z.bottom
                        z.active := false
                else if z.dir == 1
                    if high >= z.bottom and close < z.bottom
                        if enBrk and baseGate and not suOn and z.touches <= brkMaxMitig
                            float entryPx = entryMode == "Market on close" ? close : (z.top + z.bottom) / 2
                            float stpPx = z.top + stopBufTicks * tick
                            float risk = stpPx - entryPx
                            if risk >= minStopTicks * tick and risk <= maxStopAtr * atr
                                [fin, finKind, oppD] = f_draw(-1, entryPx, risk)
                                float rr = (entryPx - fin) / risk
                                bool oppNear = not na(oppD) and oppD < risk
                                bool biasGate = biasMode == "A · Strict alignment" ? biasDir <= 0 : true
                                bool inOte = not na(oteShortLo) and entryPx >= oteShortLo and entryPx <= oteShortHi
                                bool dirCap = not oneEachSide or shortsDay < 1
                                if biasGate and dirCap and rr >= minRR and not (rejectOppClose and oppNear) and not chaseBar
                                    [sc, det] = f_score(-1, 10, rr, "BRK", z.touches, bar_index - smtBearBar <= smtValidBars, inOte, false, oppNear)
                                    if sc >= minScore
                                        suOn := true
                                        suId := syminfo.tickerid + "|BREAKER_RETEST|S|BRK|" + f_px(z.bottom) + "|" + str.tostring(z.brokenBar) + "|" + str.tostring(time)
                                        suType := "BREAKER_RETEST"
                                        suDir := -1
                                        suState := ST_ENTRY_ACTIVE
                                        suEntry := f_rt(entryPx)
                                        suStop := f_rt(stpPx)
                                        suT1 := f_rt(entryPx - risk * tp1R)
                                        suT2 := f_rt(entryPx - risk * tp2R)
                                        suFin := f_rt(fin)
                                        suRR := rr
                                        suScore := sc
                                        suDet := det
                                        suLiqKind := "BREAKER"
                                        suConfirmBar := bar_index
                                        suExpiryBar := bar_index + entryExpiry
                                        suSweepExt := stpPx
                                        suSmt := bar_index - smtBearBar <= smtValidBars
                                        sigDay += 1
                                        sigSess += 1
                                        shortsDay += 1
                                        evQualBear := true
                                        evBrkBear := true
                        z.touches += 1
                    else if close > z.top
                        z.active := false

    // ── 16.12 active-setup monitoring (drives cancellations below) ──
    if suOn and bar_index > suConfirmBar
        if suState == ST_ENTRY_ACTIVE
            bool oppMss = suDir == 1 ? mssBearNow : mssBullNow
            bool tgtFirst = suDir == 1 ? high >= suFin : low <= suFin
            bool invalidNow = suDir == 1 ? close < suSweepExt : close > suSweepExt
            bool touched = suDir == 1 ? low <= suEntry : high >= suEntry
            if bar_index > suExpiryBar or tgtFirst or oppMss
                suState := ST_CANCELED
                evCancel := true
                suOn := false
                cooldownUntil := bar_index + cooldownBars
            else if invalidNow
                suState := ST_INVALID
                evInvalid := true
                suOn := false
                cooldownUntil := bar_index + cooldownBars
            else if touched
                suState := ST_OPEN
                evTouch := true
        else if suState == ST_OPEN
            bool stopHit = suDir == 1 ? low <= suStop : high >= suStop
            bool finHit  = suDir == 1 ? high >= suFin : low <= suFin
            if stopHit or finHit
                suState := ST_CLOSED
                suOn := false
                cooldownUntil := bar_index + cooldownBars

// ═══════════════ MODULE S1 · WEBHOOK JSON BUILDER (strategy) ═══════════════
f_json(string event, string sideTxt, string ordType, float qtyV, float entryP, float stopP, float t1P, float t2P, float finP, float rrV, float scoreV, string liqK, string reasonTxt, bool reduceOnly) =>
    string idk = suId + "_" + event + "_" + str.tostring(time)
    string j = '{"system":"' + f_esc(stratAlias) + '","version":"2.0.0"'
    j += ',"event":"' + event + '"'
    j += ',"setup_id":"' + f_esc(suId) + '"'
    j += ',"idempotency_key":"' + f_esc(idk) + '"'
    j += ',"account_alias":"' + f_esc(acctAlias) + '"'
    j += ',"ticker":"' + f_esc(syminfo.tickerid) + '"'
    j += ',"broker_symbol":"' + f_esc(brokerSymbol == "" ? syminfo.ticker : brokerSymbol) + '"'
    j += ',"timeframe":"' + f_esc(timeframe.period) + '"'
    j += ',"timestamp_utc":' + str.tostring(time)
    j += ',"timezone":"' + f_esc(tzStr) + '"'
    j += ',"setup":"' + f_esc(suType) + '"'
    j += ',"side":"' + sideTxt + '"'
    j += ',"order_type":"' + ordType + '"'
    j += ',"time_in_force":"DAY"'
    j += ',"quantity":' + str.tostring(nz(qtyV, 0), "#.######")
    j += ',"entry":' + f_px(entryP)
    j += ',"stop":' + f_px(stopP)
    j += ',"target_1":' + f_px(t1P)
    j += ',"target_2":' + f_px(t2P)
    j += ',"final_target":' + f_px(finP)
    j += ',"risk_percent":' + str.tostring(riskPct, "#.####")
    j += ',"risk_amount":' + str.tostring(nz(tradeRiskDollars, 0), "#.##")
    j += ',"projected_rr":' + str.tostring(nz(rrV, 0), "#.##")
    j += ',"confluence_score":' + str.tostring(nz(scoreV, 0), "#")
    j += ',"bias":"' + biasTxt + '"'
    j += ',"session":"' + sessTag + '"'
    j += ',"liquidity_type":"' + f_esc(liqK) + '"'
    j += ',"smt_symbol":"' + f_esc(suSmt ? smtSym1 : "") + '"'
    j += ',"smt_direction":"' + (suSmt ? (suDir == 1 ? "BULLISH" : "BEARISH") : "") + '"'
    j += ',"reduce_only":' + (reduceOnly ? "true" : "false")
    j += ',"bar_confirmed":true'
    j += ',"reason":"' + f_esc(reasonTxt) + '"'
    j += ',"auth_token":"' + f_esc(authToken) + '"'
    j += '}'
    j

// ═══════════════ MODULE S2 · ORDER ENGINE & TRADE MANAGEMENT ═══════════════
if barstate.isconfirmed
    // ── S2.1 place entry on a freshly confirmed setup ──
    if (evQualBull or evQualBear) and strategy.position_size == 0 and not pendingActive and not riskLocked and inDateRange and execOk
        float stopDist = math.abs(suEntry - suStop)
        float riskCapital = strategy.equity * riskPct / 100
        float riskPerUnit = stopDist * pointVal
        float qtyF = riskPerUnit > 0 ? riskCapital / riskPerUnit : 0.0
        float qty = math.floor(qtyF / lotStep) * lotStep
        qty := math.min(qty, maxQty)
        if qty >= minQty
            pendId := (suDir == 1 ? "L" : "S") + str.tostring(bar_index)
            curStop := suStop
            initQty := qty
            tradeRiskDollars := stopDist * pointVal * qty
            lastScoreAtEntry := suScore
            typeAtEntry := suType
            sessAtEntry := sessTag
            dowAtEntry := dow
            beDone := false
            alert(f_json("SETUP_CONFIRMED", suDir == 1 ? "BUY" : "SELL", entryMode == "Market on close" ? "MARKET" : "LIMIT", qty, suEntry, suStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "", false), alert.freq_once_per_bar_close)
            if entryMode == "Market on close"
                strategy.entry(pendId, suDir == 1 ? strategy.long : strategy.short, qty = qty, comment = suType, alert_message = f_json("ENTRY_FILLED", suDir == 1 ? "BUY" : "SELL", "MARKET", qty, suEntry, suStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "market_on_confirmed_close", false))
                pendingActive := true
            else
                float lim = suDir == 1 ? suEntry - verifyTicks * tick : suEntry + verifyTicks * tick
                strategy.entry(pendId, suDir == 1 ? strategy.long : strategy.short, qty = qty, limit = lim, comment = suType, alert_message = f_json("ENTRY_FILLED", suDir == 1 ? "BUY" : "SELL", "LIMIT", qty, lim, suStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "limit_at_entry_array", false))
                pendingActive := true
            alert(f_json("ENTRY_SUBMITTED", suDir == 1 ? "BUY" : "SELL", entryMode == "Market on close" ? "MARKET" : "LIMIT", qty, suEntry, suStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "", false), alert.freq_once_per_bar_close)
        else
            alert(f_json("ENTRY_SKIPPED_RISK", suDir == 1 ? "BUY" : "SELL", "NONE", 0, suEntry, suStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "quantity_below_minimum", false), alert.freq_once_per_bar_close)

    // ── S2.2 pending-order lifecycle ──
    bool fillDetected = strategy.position_size != 0 and strategy.position_size[1] == 0
    if fillDetected
        pendingActive := false
        entryBarActual := bar_index
        float fillPx = strategy.opentrades.entry_price(0)
        // recompute realized dollar risk from the actual fill
        tradeRiskDollars := math.abs(fillPx - curStop) * pointVal * math.abs(strategy.position_size)
    if pendingActive and strategy.position_size == 0 and not suOn
        // core state machine resolved the setup (expiry / target-first / opposite
        // MSS / invalidation) while the limit was still unfilled → cancel it
        strategy.cancel(pendId)
        pendingActive := false
        alert(f_json("ENTRY_CANCELED", "NONE", "CANCEL", 0, suEntry, suStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, suState == ST_INVALID ? "setup_invalidated" : "setup_canceled", false), alert.freq_once_per_bar_close)
    if pendingActive and strategy.position_size == 0 and riskLocked
        strategy.cancel(pendId)
        pendingActive := false
        alert(f_json("ENTRY_CANCELED", "NONE", "CANCEL", 0, suEntry, suStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "risk_lockout", false), alert.freq_once_per_bar_close)

    // ── S2.3 open-position management ──
    if strategy.position_size != 0
        bool isLong = strategy.position_size > 0
        float fillPx = strategy.opentrades.entry_price(0)
        float perUnitRisk = math.abs(fillPx - suStop)
        float progR = perUnitRisk > 0 ? (isLong ? close - fillPx : fillPx - close) / perUnitRisk : 0.0
        bool tp1Done = math.abs(strategy.position_size) < initQty
        // break-even (never widens the stop)
        bool beTrig = beMode == "After TP1" ? tp1Done : beMode == "After R threshold" ? progR >= beTrigR : beMode == "After TP1 or R" ? (tp1Done or progR >= beTrigR) : false
        if beTrig and not beDone
            float bePx = isLong ? fillPx + beOffTicks * tick : fillPx - beOffTicks * tick
            curStop := isLong ? math.max(curStop, bePx) : math.min(curStop, bePx)
            beDone := true
        // trailing (one methodology at a time; never widens)
        if trailMode == "ATR" and progR >= trailArmR
            float cand = isLong ? close - trailAtrMult * atr : close + trailAtrMult * atr
            curStop := isLong ? math.max(curStop, cand) : math.min(curStop, cand)
        if trailMode == "Swing" and progR >= trailArmR
            float sw = isLong ? f_lastSwingBefore(intLo, bar_index) : f_lastSwingBefore(intHi, bar_index)
            if not na(sw)
                float cand = isLong ? sw - stopBufTicks * tick : sw + stopBufTicks * tick
                curStop := isLong ? math.max(curStop, cand) : math.min(curStop, cand)
        // exits (re-issued every bar so stop updates apply; ids stay constant)
        float q1 = math.floor(initQty * tp1Pct / 100 / lotStep) * lotStep
        float q2 = math.floor(initQty * tp2Pct / 100 / lotStep) * lotStep
        if q1 > 0
            strategy.exit("TP1", from_entry = pendId, qty = q1, limit = suT1, stop = curStop, comment_profit = "TP1", comment_loss = "STOP", alert_message = f_json("TP1_OR_STOP_FILLED", isLong ? "SELL" : "BUY", "EXIT", q1, suT1, curStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "tp1_limit_or_protective_stop", true))
        if q2 > 0
            strategy.exit("TP2", from_entry = pendId, qty = q2, limit = suT2, stop = curStop, comment_profit = "TP2", comment_loss = "STOP", alert_message = f_json("TP2_OR_STOP_FILLED", isLong ? "SELL" : "BUY", "EXIT", q2, suT2, curStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "tp2_limit_or_protective_stop", true))
        strategy.exit("FIN", from_entry = pendId, qty_percent = 100, limit = suFin, stop = curStop, comment_profit = "FINAL", comment_loss = "STOP", alert_message = f_json("FINAL_OR_STOP_FILLED", isLong ? "SELL" : "BUY", "EXIT", math.abs(strategy.position_size), suFin, curStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "final_target_or_protective_stop", true))
        // discretionary closes
        if exitOppMss and ((isLong and mssBearNow) or (not isLong and mssBullNow))
            strategy.close(pendId, comment = "MSS_EXIT", alert_message = f_json("FINAL_EXIT", isLong ? "SELL" : "BUY", "MARKET", math.abs(strategy.position_size), close, curStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "opposite_mss", true))
        if maxBarsTrade > 0 and bar_index - entryBarActual >= maxBarsTrade
            strategy.close(pendId, comment = "TIME_STOP", alert_message = f_json("FINAL_EXIT", isLong ? "SELL" : "BUY", "MARKET", math.abs(strategy.position_size), close, curStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "time_stop", true))

    // ── S2.4 force flat & lockout notifications ──
    if useForceFlat and inFlat
        if strategy.position_size != 0
            strategy.close_all(comment = "FORCE_FLAT", alert_message = f_json("FORCE_FLAT", strategy.position_size > 0 ? "SELL" : "BUY", "MARKET", math.abs(strategy.position_size), close, curStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "force_flat_window", true))
        if pendingActive
            strategy.cancel_all()
            pendingActive := false
            alert(f_json("ENTRY_CANCELED", "NONE", "CANCEL", 0, suEntry, suStop, suT1, suT2, suFin, suRR, suScore, suLiqKind, "force_flat_window", false), alert.freq_once_per_bar_close)
        if suOn
            suOn := false
            suState := ST_CANCELED
    if evLockout
        alert(f_json("RISK_LOCKOUT", "NONE", "NONE", 0, close, close, close, close, close, 0, 0, lockReason, lockReason, false), alert.freq_once_per_bar_close)
    if evSmtInfo
        alert(f_json("SMT_DIVERGENCE_INFO", "NONE", "NONE", 0, close, close, close, close, close, 0, 0, "SMT_INFO", "informational_only_not_a_trade", false), alert.freq_once_per_bar_close)

// ═══════════════════════════════ MODULE S3 · VISUALS ═══════════════════════
plotshape(evQualBull, "Confirmed long setup",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.teal, 0), size = size.small)
plotshape(evQualBear, "Confirmed short setup", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),  size = size.small)
plotshape(devShow and evDevBull, "Developing long",  style = shape.circle, location = location.belowbar, color = color.new(color.teal, 55), size = size.tiny)
plotshape(devShow and evDevBear, "Developing short", style = shape.circle, location = location.abovebar, color = color.new(color.red, 55),  size = size.tiny)
plot(showPd ? drEq : na, "Equilibrium", color = color.new(color.orange, 40), style = plot.style_linebr)
plot(showOpens ? midnOpen : na, "Midnight open", color = color.new(color.blue, 55), style = plot.style_linebr)
plot(showOpens ? dOpen : na, "Daily open", color = color.new(color.purple, 55), style = plot.style_linebr)

if barstate.isconfirmed and showMarks and (evQualBull or evQualBear)
    label.new(bar_index, evQualBull ? low : high, suType + " " + (evQualBull ? "LONG" : "SHORT") + "\nScore " + str.tostring(suScore, "#") + " · RR " + str.tostring(suRR, "#.##"), style = evQualBull ? label.style_label_up : label.style_label_down, color = color.new(evQualBull ? color.teal : color.red, 20), textcolor = color.white, size = size.small)
if parityMode and barstate.isconfirmed and (evQualBull or evQualBear)
    label.new(bar_index, evQualBull ? high : low, "P|" + suType + "|" + (suDir == 1 ? "L" : "S") + "|" + str.tostring(suScore, "#") + "|" + suLiqKind, style = label.style_label_left, color = color.new(color.gray, 30), textcolor = color.yellow, size = size.tiny)

var line eLn = na
var line sLn = na
var line tLn = na
if showSetup and barstate.isconfirmed and (evQualBull or evQualBear)
    if not na(eLn)
        line.delete(eLn)
    if not na(sLn)
        line.delete(sLn)
    if not na(tLn)
        line.delete(tLn)
    eLn := line.new(bar_index, suEntry, bar_index + entryExpiry, suEntry, color = color.new(color.blue, 0), width = 2)
    sLn := line.new(bar_index, suStop,  bar_index + entryExpiry, suStop,  color = color.new(color.red, 0),  width = 2)
    tLn := line.new(bar_index, suFin,   bar_index + entryExpiry, suFin,   color = color.new(color.green, 0), width = 2)

// ═══════════════════════════════ MODULE S4 · DASHBOARD ═════════════════════
var table dash = table.new(position.top_right, 2, 30, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.silver, 10), text_halign = text.align_left, text_size = size.tiny)
    table.cell(dash, 1, r, v, text_color = vc, text_halign = text.align_right, text_size = size.tiny)
    true
if showDash and barstate.islast
    color cN = color.white
    color cG = color.new(color.teal, 0)
    color cR = color.new(color.red, 0)
    color cY = color.new(color.yellow, 0)
    f_row(0,  "ICT/SMT ENGINE", "v2.0.0 [STRAT]", cY)
    f_row(1,  "Symbol / TF", syminfo.ticker + " / " + timeframe.period, tfWarn ? cY : cN)
    f_row(2,  "Preset / Bias mode", preset + " / " + biasMode, cN)
    f_row(3,  "Timezone / Session", tzStr + " / " + sessTag, cN)
    f_row(4,  "Trading allowed", sessionEligible and not riskLocked ? "YES" : "NO", sessionEligible and not riskLocked ? cG : cR)
    f_row(5,  "HTF bias (blend)", biasTxt + " (" + str.tostring(biasSum) + ")", biasDir == 1 ? cG : biasDir == -1 ? cR : cN)
    f_row(6,  "Premium/Discount", inDiscount ? "DISCOUNT" : inPremium ? "PREMIUM" : "—", inDiscount ? cG : inPremium ? cR : cN)
    f_row(7,  "SMT sym1 / corr", smtSym1 + " / " + (na(corr1) ? "n/a" : str.tostring(corr1, "#.##")), smt1Avail ? cG : cY)
    f_row(8,  "SMT state", bar_index - smtBullBar <= smtValidBars ? "BULL div" : bar_index - smtBearBar <= smtValidBars ? "BEAR div" : smt1Avail ? "none" : "UNAVAILABLE", smt1Avail ? cN : cY)
    f_row(9,  "Setup", suOn ? suType + (suDir == 1 ? " LONG" : " SHORT") : "—", suOn ? cY : cN)
    f_row(10, "Score / class", suOn ? str.tostring(suScore, "#") + " / " + f_class(suScore) : "—", suOn ? (suScore >= 90 ? cG : cY) : cN)
    f_row(11, "Entry / Stop", suOn ? f_px(suEntry) + " / " + f_px(suStop) : "—", cN)
    f_row(12, "T1 / T2 / Final", suOn ? f_px(suT1) + " / " + f_px(suT2) + " / " + f_px(suFin) : "—", cN)
    f_row(13, "Projected R:R", suOn ? str.tostring(suRR, "#.##") + "R" : "—", cN)
    f_row(14, "Position", strategy.position_size > 0 ? "LONG " + str.tostring(strategy.position_size, "#.##") : strategy.position_size < 0 ? "SHORT " + str.tostring(-strategy.position_size, "#.##") : pendingActive ? "PENDING" : "FLAT", strategy.position_size != 0 ? cG : cN)
    f_row(15, "Current stop", strategy.position_size != 0 ? f_px(curStop) : "—", cN)
    f_row(16, "Point value (check!)", str.tostring(pointVal, "#.####") + (ptValOverride > 0 ? " (override)" : " (auto)"), cY)
    f_row(17, "Trades today / sess", str.tostring(tradesToday) + "/" + str.tostring(maxTradesDay) + " · " + str.tostring(tradesSess) + "/" + str.tostring(maxTradesSess), tradesToday >= maxTradesDay ? cR : cN)
    f_row(18, "Daily R / Weekly R", str.tostring(dayR, "#.##") + " / " + str.tostring(weekR, "#.##"), dayR < 0 ? cR : cG)
    f_row(19, "Consecutive losses", str.tostring(consecLoss) + "/" + str.tostring(maxConsecLoss), consecLoss >= maxConsecLoss ? cR : cN)
    f_row(20, "Risk lockout", riskLocked ? "LOCKED: " + lockReason : "clear", riskLocked ? cR : cG)
    f_row(21, "Risk % / equity", str.tostring(riskPct, "#.##") + "% / " + str.tostring(strategy.equity, "#"), cN)
    f_row(22, "ATR pct / RelVol", str.tostring(atrPct, "#") + " / " + str.tostring(relVol, "#.##"), atrPct < atrPctLow or atrPct > atrPctHigh ? cY : cN)
    f_row(23, "Min score / R:R", str.tostring(minScore) + " / " + str.tostring(minRR, "#.##"), cN)
    f_row(24, "Non-repaint mode", "CONFIRMED BARS ONLY", cG)
    string warn = (tfWarn ? "Chart TF ≠ preset TF. " : "") + (htfCfgOk ? "" : "HTF config invalid — signals disabled. ") + (na(c1c) ? "SMT symbol data missing. " : "") + (not smt1Avail and not na(c1c) ? "SMT corr below threshold — SMT points removed. " : "") + (synthChart ? "SYNTHETIC CHART — entries blocked. " : "") + (strategy.closedtrades > 0 and strategy.closedtrades < 30 ? "Backtest sample < 30 trades — insufficient. " : "")
    f_row(25, "Warnings", warn == "" ? "none" : warn, warn == "" ? cN : cR)
    if showDetail
        f_row(26, "Score detail", suOn ? suDet : "—", cN)
    f_row(27, "Costs (Properties)", "commission $1.25/ct · slippage 1 tick — verify!", cY)

// ═══════════════ MODULE S5 · STATISTICS & CALIBRATION TABLE ═════════════════
var table stat = table.new(position.bottom_right, 7, 14, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.new(color.gray, 60))
f_scell(int c, int r, string v, color tc) =>
    table.cell(stat, c, r, v, text_color = tc, text_halign = text.align_right, text_size = size.tiny)
    true
if showStats and barstate.islast
    color hN = color.new(color.silver, 0)
    color hY = color.new(color.yellow, 0)
    int nTr = array.size(tradeRs)
    float sumR = 0.0
    if nTr > 0
        for i = 0 to nTr - 1
            sumR += array.get(tradeRs, i)
    float avgR = nTr > 0 ? sumR / nTr : na
    float medR = na
    if nTr > 0
        array<float> cp = array.copy(tradeRs)
        array.sort(cp, order.ascending)
        medR := array.get(cp, math.floor(nTr / 2))
    float top5 = na
    if nTr >= 5 and strategy.netprofit > 0
        array<float> cpp = array.copy(tradePnls)
        array.sort(cpp, order.descending)
        float t5 = 0.0
        for i = 0 to 4
            t5 += array.get(cpp, i)
        top5 := 100 * t5 / strategy.netprofit
    float pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    f_scell(0, 0, "STATISTICS", hY)
    f_scell(1, 0, "Trades " + str.tostring(strategy.closedtrades), hN)
    f_scell(2, 0, "Setups " + str.tostring(nTr), hN)
    f_scell(3, 0, "PF " + (na(pf) ? "n/a" : str.tostring(pf, "#.##")), hN)
    f_scell(4, 0, "AvgR " + (na(avgR) ? "n/a" : str.tostring(avgR, "#.##")), hN)
    f_scell(5, 0, "MedR " + (na(medR) ? "n/a" : str.tostring(medR, "#.##")), hN)
    f_scell(6, 0, "Top5 " + (na(top5) ? "n/a" : str.tostring(top5, "#") + "%"), na(top5) or top5 < 60 ? hN : hY)
    f_scell(0, 1, "Sample status", hN)
    string sampTxt = nTr < 30 ? "INSUFFICIENT SAMPLE (<30)" : nTr < 100 ? "PRELIMINARY (30-99)" : "ESTABLISHED SAMPLE (≥100) — not 'proven'"
    f_scell(1, 1, sampTxt, nTr < 30 ? color.new(color.red, 0) : hN)
    f_scell(2, 1, "MaxConsecLoss " + str.tostring(maxConsecLossEver), hN)
    f_scell(3, 1, "NetPnl " + str.tostring(strategy.netprofit, "#"), hN)
    f_scell(4, 1, "MaxDD " + str.tostring(strategy.max_drawdown, "#"), hN)
    f_scell(5, 1, "GrossP " + str.tostring(strategy.grossprofit, "#"), hN)
    f_scell(6, 1, "GrossL " + str.tostring(strategy.grossloss, "#"), hN)
    if showBuckets
        f_scell(0, 2, "SCORE BUCKET", hY)
        f_scell(1, 2, "N", hY)
        f_scell(2, 2, "Win%", hY)
        f_scell(3, 2, "Wilson 95% CI", hY)
        f_scell(4, 2, "ExpR", hY)
        f_scell(5, 2, "Wins", hY)
        f_scell(6, 2, "Losses", hY)
        for bi = 0 to 5
            string bLabel = bi == 0 ? "70-74" : bi == 1 ? "75-79" : bi == 2 ? "80-84" : bi == 3 ? "85-89" : bi == 4 ? "90-94" : "95-100"
            int w = array.get(bW, bi)
            int l = array.get(bL, bi)
            int nb = w + l
            f_scell(0, 3 + bi, bLabel, hN)
            f_scell(1, 3 + bi, str.tostring(nb), hN)
            f_scell(2, 3 + bi, nb > 0 ? str.tostring(100.0 * w / nb, "#.#") + "%" : "n/a", hN)
            f_scell(3, 3 + bi, nb > 0 ? str.tostring(100 * f_wilson(w, nb, false), "#") + "-" + str.tostring(100 * f_wilson(w, nb, true), "#") + "%" : "n/a", hN)
            f_scell(4, 3 + bi, nb > 0 ? str.tostring(array.get(bRsum, bi) / nb, "#.##") : "n/a", hN)
            f_scell(5, 3 + bi, str.tostring(w), hN)
            f_scell(6, 3 + bi, nb < 30 ? str.tostring(l) + " (small n!)" : str.tostring(l), nb < 30 ? hY : hN)
    f_scell(0, 9, "WEEKDAY R (validate the Mon-off default!)", hY)
    f_scell(1, 9, "Mon " + (array.get(dN, 0) > 0 ? str.tostring(array.get(dR, 0), "#.#") + " (" + str.tostring(array.get(dN, 0)) + ")" : "—"), hN)
    f_scell(2, 9, "Tue " + (array.get(dN, 1) > 0 ? str.tostring(array.get(dR, 1), "#.#") + " (" + str.tostring(array.get(dN, 1)) + ")" : "—"), hN)
    f_scell(3, 9, "Wed " + (array.get(dN, 2) > 0 ? str.tostring(array.get(dR, 2), "#.#") + " (" + str.tostring(array.get(dN, 2)) + ")" : "—"), hN)
    f_scell(4, 9, "Thu " + (array.get(dN, 3) > 0 ? str.tostring(array.get(dR, 3), "#.#") + " (" + str.tostring(array.get(dN, 3)) + ")" : "—"), hN)
    f_scell(5, 9, "Fri " + (array.get(dN, 4) > 0 ? str.tostring(array.get(dR, 4), "#.#") + " (" + str.tostring(array.get(dN, 4)) + ")" : "—"), hN)
    f_scell(6, 9, "", hN)
    f_scell(0, 10, "SETUP R (n)", hY)
    f_scell(1, 10, "TS " + (array.get(sN, 0) > 0 ? str.tostring(array.get(sR, 0), "#.#") + " (" + str.tostring(array.get(sN, 0)) + ")" : "—"), hN)
    f_scell(2, 10, "JUD " + (array.get(sN, 1) > 0 ? str.tostring(array.get(sR, 1), "#.#") + " (" + str.tostring(array.get(sN, 1)) + ")" : "—"), hN)
    f_scell(3, 10, "FVGC " + (array.get(sN, 2) > 0 ? str.tostring(array.get(sR, 2), "#.#") + " (" + str.tostring(array.get(sN, 2)) + ")" : "—"), hN)
    f_scell(4, 10, "BRK " + (array.get(sN, 3) > 0 ? str.tostring(array.get(sR, 3), "#.#") + " (" + str.tostring(array.get(sN, 3)) + ")" : "—"), hN)
    f_scell(5, 10, "SMTR " + (array.get(sN, 4) > 0 ? str.tostring(array.get(sR, 4), "#.#") + " (" + str.tostring(array.get(sN, 4)) + ")" : "—"), hN)
    f_scell(6, 10, "", hN)
