//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  PRECISION ICT/SMT INTELLIGENCE ENGINE — STRATEGY / WEBHOOK BOT  (v2.0.0)
//  Deliverable B of 3.  The signal core (modules 1–16) is line-identical with
//  the indicator script (Deliverable A) — see docs/PARITY.md.
//
//  NON-REPAINTING CONTRACT — identical to the indicator, plus:
//  · calc_on_every_tick = false, calc_on_order_fills = false, pyramiding = 0.
//  · Orders are created only on confirmed bars; fills are handled by the
//    broker emulator with a 1-tick limit-verification assumption
//    (backtest_fill_limits_assumption = 1) and default 1-tick slippage +
//    per-contract commission. Tune both in the Properties tab.
//  · process_orders_on_close stays false (declaration constant). Enabling it
//    in Properties makes market orders fill on the signal close instead of
//    the next open — more optimistic; keep it off for conservative results.
//  · Bar Magnifier can be enabled in Properties for intrabar fill precision
//    on premium plans — recommended whenever limit/stop pairs are close.
//
//  WEBHOOKS — create ONE alert on this strategy with "Order fills and alert()
//  function calls", message = {{strategy.order.alert_message}}, and your
//  bridge URL as the webhook. Never put broker usernames, passwords, or API
//  secrets in alert bodies; the auth_token input is an opaque shared token
//  validated by YOUR bridge, and it is never drawn on the chart.
// ═══════════════════════════════════════════════════════════════════════════
strategy("Precision ICT/SMT Intelligence Engine — Strategy", shorttitle = "ICT/SMT [STRAT]", overlay = true, initial_capital = 25000, currency = currency.NONE, commission_type = strategy.commission.cash_per_contract, commission_value = 1.25, slippage = 1, backtest_fill_limits_assumption = 1, calc_on_every_tick = false, calc_on_order_fills = false, process_orders_on_close = false, pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────── TYPES ─────
type LiqLevel
    string  kind
    float   price
    bool    isHigh          // true = buy-side (above), false = sell-side (below)
    int     createdBar
    int     confirmBar
    int     priority        // 1 = highest significance
    int     touches
    bool    swept
    int     sweptBar
    line    ln

type Fvg
    float   top
    float   bottom
    int     dir             // 1 bullish, -1 bearish
    int     createdBar
    int     touches
    float   fillPct
    bool    active
    bool    qualified
    box     bx

type Zone                   // order block / breaker
    float   top
    float   bottom
    int     dir             // dir of the OB's ORIGINAL implication (1 = bullish OB)
    int     createdBar
    int     touches
    bool    broken
    int     brokenBar
    bool    isBreaker
    bool    active
    box     bx

type Swing
    float   price
    int     pivotBar
    int     confirmBar
    bool    broken

// ──────────────────────────────────────────────────────────── CONSTANTS ────
int ST_IDLE = 0
int ST_ENTRY_ACTIVE = 7
int ST_OPEN = 9
int ST_CLOSED = 11
int ST_INVALID = 12
int ST_CANCELED = 13

// ═══════════════════════════════════════════ MODULE 1 · CONFIGURATION ══════
G1  = "1 · Preset & Bias Mode"
G2  = "2 · Timezone & Sessions"
G3  = "3 · Weekdays & Daily Limits"
G4  = "4 · Timeframes (HTF)"
G5  = "5 · Swings & Structure"
G6  = "6 · Liquidity & Equal H/L"
G7  = "7 · Sweep / Reclaim"
G8  = "8 · Displacement & MSS"
G9  = "9 · FVG / OB / Breaker"
G10 = "10 · SMT & Correlation"
G11 = "11 · Score Weights (100)"
G12 = "12 · Penalties & Regime"
G13 = "13 · Setups & Entry"
G14 = "14 · Risk / Stops / Targets"
G15 = "15 · Visuals & Dashboard"
G16 = "16 · Alerts & Parity"
G17 = "17 · Risk Engine & Sizing"
G18 = "18 · Trade Management"
G19 = "19 · Execution & Backtest"
G20 = "20 · Webhook"
G21 = "21 · Statistics & Calibration"

preset       = input.string("Balanced", "Preset", options = ["A+ Selective", "Balanced", "Active", "Research", "Custom"], group = G1, tooltip = "Presets set min score / min R:R / expected chart TF. 'Custom' uses the manual inputs below. Presets never weaken confirmation or repainting protections.")
biasMode     = input.string("A · Strict alignment", "HTF bias mode", options = ["A · Strict alignment", "B · Adaptive liquidity reversal", "C · Neutral research"], group = G1)
minScoreIn   = input.int(80, "Min confluence score (Custom)", minval = 50, maxval = 100, group = G1)
minRRIn      = input.float(2.0, "Min projected R:R (Custom)", minval = 0.5, step = 0.25, group = G1)
smtMandC     = input.bool(false, "Mode C: SMT mandatory for all setups", group = G1)

tzStr        = input.string("America/New_York", "Session timezone", group = G2)
sessAsia     = input.session("2000-0000", "Asia reference range", group = G2)
sessAsiaX    = input.session("2000-0500", "Extended Asia range", group = G2)
sessLKZ      = input.session("0200-0500", "London Kill Zone", group = G2)
sessPre      = input.session("0800-0930", "NY premarket", group = G2)
sessNYAM     = input.session("0930-1100", "NY AM window", group = G2)
sessNYPref   = input.session("0930-1030", "Preferred NY window (bonus)", group = G2)
sessLC       = input.session("1000-1200", "London close window", group = G2)
sessLunch    = input.session("1130-1330", "Lunch exclusion", group = G2)
sessNYPM     = input.session("1330-1530", "NY PM window", group = G2)
sessOR       = input.session("0930-0945", "Opening range window", group = G2)
sessFlat     = input.session("1555-1600", "Force-flat window", group = G2)
sessNoNew    = input.session("1530-1600", "No new entries after", group = G2)
useLKZ       = input.bool(false, "Trade London Kill Zone", group = G2)
useNYAM      = input.bool(true,  "Trade NY AM window", group = G2)
useLC        = input.bool(false, "Trade London close window", group = G2)
useNYPM      = input.bool(false, "Trade NY PM window", group = G2)
allowLunch   = input.bool(false, "Allow lunch trading (default reject)", group = G2)
bo1On = input.bool(false, "Blackout 1 on", inline = "b1", group = G2)
bo1   = input.session("0825-0840", "", inline = "b1", group = G2)
bo2On = input.bool(false, "Blackout 2 on", inline = "b2", group = G2)
bo2   = input.session("0955-1010", "", inline = "b2", group = G2)
bo3On = input.bool(false, "Blackout 3 on", inline = "b3", group = G2)
bo3   = input.session("1355-1415", "", inline = "b3", group = G2)
bo4On = input.bool(false, "Blackout 4 on", inline = "b4", group = G2)
bo4   = input.session("0000-0001", "", inline = "b4", group = G2)
bo5On = input.bool(false, "Blackout 5 on", inline = "b5", group = G2)
bo5   = input.session("0000-0001", "", inline = "b5", group = G2)

tradeMon = input.bool(false, "Monday", inline = "wd", group = G3)
tradeTue = input.bool(true,  "Tue", inline = "wd", group = G3)
tradeWed = input.bool(true,  "Wed", inline = "wd", group = G3)
tradeThu = input.bool(true,  "Thu", inline = "wd", group = G3)
tradeFri = input.bool(true,  "Fri", inline = "wd", group = G3)
sessFriOk    = input.session("0000-1130", "Friday allowed window", group = G3, tooltip = "On Friday, new setups are only allowed inside this window.")
maxSigDay    = input.int(2, "Max setups per day", minval = 1, maxval = 10, group = G3)
maxSigSess   = input.int(1, "Max setups per session", minval = 1, maxval = 5, group = G3)
oneEachSide  = input.bool(false, "Max one long AND one short per day", group = G3)
cooldownBars = input.int(10, "Cooldown bars after a setup resolves", minval = 0, group = G3)

ctxTf        = input.timeframe("60",  "Context timeframe", group = G4)
biasTf       = input.timeframe("240", "HTF bias timeframe", group = G4)
warmupBars   = input.int(300, "Warm-up bars before any signal", minval = 50, group = G4)
devHtfMode   = input.bool(false, "Developing-HTF research mode (REPAINT-CAPABLE, visual only)", group = G4, tooltip = "Shows the live, unfinished HTF candle value on the dashboard for research. NEVER used for confirmed decisions or entries.")

intL = input.int(3,  "Internal swing left bars",  minval = 1, group = G5)
intR = input.int(3,  "Internal swing right bars", minval = 1, group = G5)
extL = input.int(10, "External swing left bars",  minval = 2, group = G5)
